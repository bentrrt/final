[node name="Intro" type="Label" parent="HUD/HintOverlay/Wrap/Panel/MarginContainer/VBoxContainer" unique_id=100000038]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Each carriage has a roof tag. The letter and colour show the word's job in the sentence."
autowrap_mode = 3

[node name="HintText" type="RichTextLabel" parent="HUD/HintOverlay/Wrap/Panel/MarginContainer/VBoxContainer" unique_id=100000039]
custom_minimum_size = Vector2(0, 620)
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.94, 0.97, 1, 1)
theme_override_font_sizes/normal_font_size = 24
bbcode_enabled = true
text = "[color=#598cff][b]A - Article[/b][/color]
A small word before a naming word. It shows which one or how many.
Example: [b]The[/b] train is late.

[color=#f2c94d][b]P - Pronoun[/b][/color]
Pronoun: a word that replaces a naming word.
Example: [b]She[/b] has a cat.

[color=#59bf73][b]N - Noun[/b][/color]
A naming word for a person, place, thing, or idea.
Example: The [b]train[/b] is late.

[color=#f28c4d][b]V - Verb[/b][/color]
An action or state word. It tells what happens.
Example: The train [b]is[/b] late.

[color=#b373d9][b]D - Adjective[/b][/color]
A describing word. It tells what something is like.
Example: The train is [b]late[/b].

[color=#999999][b]T - Particle[/b][/color]
A small word that completes a verb phrase.
Example: Put the box [b]down[/b].


[i]Read the example. The bold word is the tag.[/i]"

